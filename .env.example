# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   copy .env.example .env
#
# A real environment variable always wins over this file, so an exported
# ANTHROPIC_API_KEY is not shadowed by a stale value here.

# Tier 4 (Claude Haiku 4.5) intent routing. Optional — without it the cascade
# simply stops at tier 3 and everything else keeps working.
ANTHROPIC_API_KEY=
